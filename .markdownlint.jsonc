// markdownlint configuration — relaxed for instructional content.
// https://github.com/DavidAnson/markdownlint/blob/main/doc/Rules.md
{
  "default": true,
  "MD013": false,   // line length — prose + tables run long in labs
  "MD033": false,   // inline HTML — used for asides/callouts
  "MD041": false,   // first line need not be a top-level heading (front-matter)
  "MD024": { "siblings_only": true },
  "MD046": false,   // allow both fenced + indented code in mixed lab content
  "MD029": false    // ordered list numbering style varies in step lists
}
