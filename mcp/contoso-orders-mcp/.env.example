# Contoso Orders MCP server — configuration (prefix ORDERS_MCP_).
# Copy to `.env` for local runs. Defaults run fully offline against packaged
# fixtures with ZERO Azure cost and NO egress.

# --- Transport / hosting --------------------------------------------------
ORDERS_MCP_TRANSPORT=stdio          # stdio | sse | streamable-http
ORDERS_MCP_HOST=127.0.0.1           # bind host for HTTP transports
ORDERS_MCP_PORT=8080                # bind port for HTTP transports

# --- Live Orders API egress (managed identity, NO keys) -------------------
# Set ORDERS_MCP_API_BASE_URL to switch from fixtures to the live downstream
# API. The server then authenticates with DefaultAzureCredential (no keys).
# ORDERS_MCP_API_BASE_URL=https://orders.internal.contoso.example
ORDERS_MCP_API_SCOPE=api://contoso-orders/.default
ORDERS_MCP_REQUEST_TIMEOUT_SECONDS=15

# --- Secrets via Key Vault (resolved at runtime via managed identity) -----
# ORDERS_MCP_KEY_VAULT_URI=https://kv-ccmh-<rand>.vault.azure.net/

# --- Diagnostics ----------------------------------------------------------
ORDERS_MCP_LOG_LEVEL=INFO
