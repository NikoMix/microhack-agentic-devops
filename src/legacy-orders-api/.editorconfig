# EditorConfig — Contoso Orders API (layers on top of the repo-root .editorconfig).
# Keeps the repo-wide style + analyzer contract, and dials down a small, curated set of
# analyzer rules that are categorically inappropriate for an ASP.NET Core web API sample.
# Each suppression carries a justification so the quality gate stays honest.

[*.cs]

# --- ASP.NET Core idioms -------------------------------------------------------
# CA2007: ConfigureAwait(false) is unnecessary in ASP.NET Core (no synchronization context).
dotnet_diagnostic.CA2007.severity = none
# CA1515: Web APIs intentionally expose public controllers, DTOs, and Program (for WebApplicationFactory).
dotnet_diagnostic.CA1515.severity = none
# CA1812: Types are instantiated via DI / model binding, which the analyzer cannot see.
dotnet_diagnostic.CA1812.severity = none

# --- DTO / serialization shapes ------------------------------------------------
# CA2227: Request DTO collections need setters for model binding / JSON deserialization.
dotnet_diagnostic.CA2227.severity = none
# CA1002: DTOs expose List<T>/IReadOnlyList<T> deliberately for clean JSON contracts.
dotnet_diagnostic.CA1002.severity = none

# --- Sample-clarity over micro-optimization ------------------------------------
# CA1303: No localization in this lab; InvariantGlobalization is enabled.
dotnet_diagnostic.CA1303.severity = none
# CA1848: LoggerMessage source-gen delegates add noise that obscures the teaching intent.
dotnet_diagnostic.CA1848.severity = none
# IDE0058: Fluent builder/DI calls intentionally ignore their return value.
dotnet_diagnostic.IDE0058.severity = none

# --- House code-style preferences ----------------------------------------------
# The repo-root .editorconfig bulk-enables analyzers at 'warning'; combined with
# warnings-as-errors that promotes purely subjective *formatting* rules to build
# breakers. We pin the project's house style here so correctness rules still fail the
# build while subjective layout choices are surfaced as IDE/telemetry hints instead.

# Prefer 'var': the local types in this project are intentional and read cleanly.
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = true:suggestion
dotnet_diagnostic.IDE0007.severity = silent
dotnet_diagnostic.IDE0008.severity = silent

# Allow expression-bodied members where they fit on a single line.
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_properties = true:suggestion
csharp_style_expression_bodied_accessors = true:suggestion
csharp_style_expression_bodied_lambdas = true:suggestion
dotnet_diagnostic.IDE0022.severity = silent
