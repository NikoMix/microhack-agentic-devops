<Project>
  <!--
    Shared MSBuild properties for every project under src/legacy-orders-api.
    Enforces the engineering contract: net10.0, nullable, warnings-as-errors,
    .NET analyzers + code-style enforcement at build time.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <!-- Quality gate: every warning (compiler, analyzer, style) fails the build. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>

    <!-- Reproducible, deterministic builds. -->
    <Deterministic>true</Deterministic>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!--
      Generate the XML doc file so IDE0005 (remove unnecessary usings) runs at build time
      as part of the quality gate. We do not publish API docs, so CS1591 (missing XML
      comment on a public member) is intentionally not required.
    -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
</Project>
