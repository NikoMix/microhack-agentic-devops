<Project>
  <!--
    Central Package Management (CPM) for the Contoso Orders API.
    Versions are pinned here; projects reference packages without a Version attribute.
    All versions are the latest stable releases and are scanned for vulnerabilities in CI
    (the `dotnet list package` vulnerability switch). Licenses: MIT / Apache-2.0 only.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup>
    <!-- ASP.NET Core OpenAPI document generation (first-party, version-matched to net10.0). -->
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.14" />

    <!-- Entity Framework Core in-memory provider (stateless; zero native dependencies). -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup Label="Test">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.14" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="coverlet.collector" Version="10.1.0" />
  </ItemGroup>
</Project>
