# Order Support / Triage agent — environment contract.
# Copy to `.env` for local runs. NEVER commit a real `.env`.
# Switching INFERENCE_PROVIDER swaps the model backend with NO code change.

# ---------------------------------------------------------------------------
# Provider selection: foundry | azure_openai | github_models
# Default github_models runs with only a GITHUB_TOKEN (zero Azure cost).
# ---------------------------------------------------------------------------
INFERENCE_PROVIDER=github_models

# ---- GitHub Models (default; needs only a token with `models: read`) ------
GITHUB_MODELS_ENDPOINT=https://models.github.ai/inference
GITHUB_MODELS_MODEL=openai/gpt-4o-mini
# A fine-grained PAT or the Actions token. Locally: `export GITHUB_TOKEN=$(gh auth token)`.
GITHUB_TOKEN=

# ---- Azure OpenAI (keyless via Entra / DefaultAzureCredential) ------------
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-10-21

# ---- Azure AI Foundry (keyless via Entra / DefaultAzureCredential) --------
AZURE_AI_FOUNDRY_PROJECT_ENDPOINT=
AZURE_AI_FOUNDRY_CHAT_DEPLOYMENT=gpt-4o-mini

# ---- Generation defaults --------------------------------------------------
AGENT_TEMPERATURE=0.2
AGENT_MAX_TOKENS=1024
REQUEST_TIMEOUT_SECONDS=60

# ---- Observability (OpenTelemetry -> Application Insights) ----------------
OTEL_SERVICE_NAME=order-support-agent
# Prefer wiring this from Key Vault at runtime; do not hardcode in source.
APPLICATIONINSIGHTS_CONNECTION_STRING=
ENABLE_AZURE_MONITOR=true
ENABLE_FOUNDRY_TRACING=false
# Captures prompt/response content in traces. Keep false unless debugging.
ENABLE_SENSITIVE_TELEMETRY=false

# ---- MCP integration ------------------------------------------------------
# URL of the Contoso Orders MCP server (streamable-http) when running live.
ORDERS_MCP_URL=

# ---- HTTP service ---------------------------------------------------------
HOST=0.0.0.0
PORT=8000
